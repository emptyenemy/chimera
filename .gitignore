# Binaries / build artifacts
*.exe
*.dll
*.so
*.dylib
*.o
*.a
bin/
build/
dist/
target/

# zapret prebuilt bundles (fetched separately, not part of our repo)
bin/zapret-win-bundle/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local secrets / overrides
.env
.env.local
*.local

# Runtime state
modules/hosts/state.json
# Настройки winws/zapret2 (последняя стратегия + автозапуск)
modules/winws/state.json
# Настройки tg-прокси (содержат секрет)
modules/tgproxy/state.json
# Настройки прокси (содержат ссылку с ключами) + сгенерированный конфиг sing-box и PAC
modules/proxy/state.json
modules/proxy/singbox-config.json
modules/proxy/proxy.pac
# Пользовательские DNS-провайдеры (добавляются из UI)
modules/dns_providers.user.json
# Бэкап загруженного ipset-листа при переключении фильтра (modules/winws/filters.py)
strategies/hostlists/ipset-all.txt.backup
# Активный ipset-фильтр — рантайм-состояние (any/none/скачанный список), самовосстанавливается
# как "any" при отсутствии файла (modules/winws/filters.py)
strategies/hostlists/ipset-all.txt
# Хостлист выбранных в UI списков доменов (modules/winws/manager.set_lists) — личный
# выбор пользователя, перегенерируется на пустой при отсутствии (WinwsManager.__init__)
strategies/hostlists/list-general-user.txt
# IP и подсети из тех же списков — вторая половина того же выбора, уезжает в ipset
# вместо хостлиста (modules/winws/manager._regenerate_user_hostlist)
strategies/hostlists/ipset-user.txt

# Local config (auto-создаётся с дефолтами, modules/appconfig.py)
config.json

# Logs
*.log
logs/

# Node (если вдруг)
node_modules/

# Python
__pycache__/
*.pyc
.venv/
venv/
